# Copie este arquivo para `.env` e ajuste os valores.
#   cp .env.example .env        (Linux/macOS)
#   copy .env.example .env      (Windows)
#
# O `.env` está no .gitignore e NUNCA deve ser commitado.

# --- Flask ---------------------------------------------------------------
FLASK_APP=app.py
FLASK_DEBUG=1

# Chave usada pelo Flask para assinar sessões. Gere uma nova com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-em-qualquer-ambiente-que-nao-seja-local

# --- Banco de dados ------------------------------------------------------
# Se DATABASE_URL não for definida, a aplicação usa um SQLite em
# `estoque.db` na raiz do projeto — é assim que o projeto roda sem configurar
# nada. Os models usam só tipos genéricos do SQLAlchemy, então trocar de banco
# é trocar esta linha: nenhum model, service ou migration muda.
# DATABASE_URL=sqlite:///estoque.db
# DATABASE_URL=postgresql+psycopg://usuario:senha@host.rds.amazonaws.com:5432/estoque

# Loga no console todo SQL executado. Útil para depurar, ruidoso no dia a dia.
SQLALCHEMY_ECHO=0

# Aplica as migrations pendentes ao subir a aplicação e ao rodar o seed.
# Desligue (0) se preferir rodar `flask db upgrade` na mão.
AUTO_MIGRATE=1

# --- Autenticação --------------------------------------------------------
# Chave de assinatura do JWT. Se vazia, cai no SECRET_KEY.
JWT_SECRET_KEY=troque-esta-chave-tambem
JWT_EXPIRES_HOURS=8

# --- Servidor local ------------------------------------------------------
HOST=127.0.0.1
PORT=5000
SWAGGER_URL=/swagger
